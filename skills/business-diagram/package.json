{
  "name": "mosofin",
  "version": "1.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "JSON-IR diagram renderers (architecture / workflow / sequence / dataflow / lifecycle / pillars).",
  "license": "MIT",
  "bin": {
    "mosofin": "./bin/mosofin.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "assemble:template": "node scripts/assemble-template.mjs",
    "generate:brand-marks": "node scripts/generate-brand-marks.mjs",
    "check:brand-marks": "node scripts/generate-brand-marks.mjs --check",
    "generate:domain-icons": "node scripts/generate-domain-icons.mjs",
    "check:domain-icons": "node scripts/generate-domain-icons.mjs --check",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "prepare": "npm run assemble:template && npm run generate:validators && npm run generate:brand-marks"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "lucide-static": "1.48.0",
    "parse5": "7.3.0",
    "saxes": "6.0.0",
    "simple-icons": "16.28.0"
  }
}
